
# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=rag_ingestion_resume

# Collection used for resume/candidate documents (defaults to MONGODB_DB_NAME value)
# MONGODB_COLLECTION_NAME=rag_ingestion_resume

# ── Mistral (LLM + Embeddings) ────────────────────────────────────────────────
MISTRAL_API_KEY=your_key_here
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_LLM_MODEL=mistral-small-latest
EMBEDDING_DIMENSION=1024

# Shared Groq API key for backend LLM features and the DeepEval judge
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Resume ingestion ──────────────────────────────────────────────────────────
# Set to true to enable the experimental LLM-based resume parser
USE_LLM_PARSER=false
MAX_UPLOAD_SIZE_MB=5

# ── Jobs — Discovery ──────────────────────────────────────────────────────────
# Comma-separated list of AI/ML job roles to target during discovery
JOB_SEARCH_ROLES=Junior AI Engineer,AI Engineer,Generative AI Engineer,LLM Engineer,RAG Engineer

# Primary location filter used during job discovery
JOB_SEARCH_LOCATION=South Africa

# Include remote positions in discovery results
JOB_SEARCH_REMOTE=true

# Public job search uses Adzuna's South Africa listings (country code ZA).
# Create API credentials at https://developer.adzuna.com/ and set both values.


# ── Jobs — MongoDB ────────────────────────────────────────────────────────────
# MongoDB collection that stores discovered and ingested job documents
JOB_COLLECTION_NAME=jobs

# Name of the Atlas Vector Search index on the jobs collection.
# Must be created in the Atlas UI before vector search will work.
JOB_VECTOR_INDEX_NAME=job_vector_index

# Name of the Atlas Search (full-text / BM25) index on the jobs collection.
# Must be created in the Atlas UI before Atlas-side keyword search will work.
JOB_SEARCH_INDEX_NAME=job_search_index

# ── Jobs — Retrieval ──────────────────────────────────────────────────────────
# Number of candidates retrieved from vector search per job query
JOB_VECTOR_TOP_K=10

# Number of candidates retrieved from BM25 keyword search per job query
JOB_BM25_TOP_K=10

# Maximum number of jobs returned from a hybrid search
JOB_MATCH_TOP_K=10

# ── DeepEval — job-search evaluation ─────────────────────────────────────────
# Evaluations can call the configured Groq judge and incur API usage.
DEEPEVAL_ENABLED=true
DEEPEVAL_JUDGE_MODEL=openai/gpt-oss-120b
DEEPEVAL_ALIGNMENT_THRESHOLD=0.7
DEEPEVAL_RELEVANCY_THRESHOLD=0.7
DEEPEVAL_FAITHFULNESS_THRESHOLD=0.7
DEEPEVAL_MAX_JOBS=10
# Optional override for the Python interpreter running evaluation/deepeval_job_eval.py
# DEEPEVAL_PYTHON=venv/Scripts/python.exe

# ── Jobs — Application Message ────────────────────────────────────────────────
# Mistral model used for application-message generation.
# Defaults to MISTRAL_LLM_MODEL if not set.
# APPLICATION_MESSAGE_MODEL=mistral-small-latest

# ── MCP ───────────────────────────────────────────────────────────────────────
MCP_SERVER_NAME=resume-rag-job-assistant
MCP_TRANSPORT=stdio

# ── Playwright Testing ────────────────────────────────────────────────────────
# Frontend URL (Vite dev server or preview)
BASE_URL=http://localhost:4173

# Backend Express API URL
API_BASE_URL=http://localhost:3000

# Configurable response-time threshold for performance checks (milliseconds)
RESPONSE_TIME_THRESHOLD_MS=2000

# Set to true to run the live DeepEval test that calls real Groq/judge APIs.
# DISABLED by default. Requires GROQ_API_KEY and Python venv.
# WARNING: consumes API quota. Never set true in standard CI.
RUN_LIVE_EVAL=false
