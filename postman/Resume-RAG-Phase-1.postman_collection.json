            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileName\": \"Rajesh Mohan Kumar_Test Architect & Senior Agentic Test Engineer.pdf\",\n  \"resume\": {\n    \"name\": \"Rajesh Mohan Kumar\",\n    \"email\": \"rajesh.mohan@example.com\",\n    \"phone\": \"+919876543210\",\n    \"location\": \"Chennai, India\",\n    \"company\": \"Testleaf Software Solutions Private Limited\",\n    \"role\": \"Test Architect & Senior Agentic Test Engineer\",\n    \"education\": \"B.Tech - Information Technology\",\n    \"totalExperience\": 13,\n    \"relevantExperience\": 13,\n    \"skills\": [\"Selenium WebDriver\", \"Core Java\", \"C#\", \"Python\", \"REST Assured\", \"Postman\", \"RAG\", \"DeepEval\", \"MCP (Model Context Protocol)\"],\n    \"jobTitles\": [\"Test Architect & Senior Agentic Test Engineer\", \"Lead Test Engineer\"],\n    \"experienceSummary\": \"Enterprise QA architecture, automation, RAG and LLM evaluation experience.\"\n  },\n  \"rawText\": \"Rajesh Mohan Kumar\\nTest Architect & Senior Agentic Test Engineer\\n13+ years of experience\",\n  \"embedding\": {{embeddingVector}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/v1/resume/store"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const embedding = Array.from({ length: 1024 }, (_, index) => Number((Math.sin(index + 1) * 0.01).toFixed(6)));",
              "pm.variables.set('embeddingVector', JSON.stringify(embedding));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Resume storage succeeds', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Stored resume response is valid', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.message).to.eql('Resume stored successfully');",
              "    pm.expect(body.resumeId).to.be.a('string').and.not.empty;",
              "    pm.collectionVariables.set('storedResumeId', body.resumeId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
