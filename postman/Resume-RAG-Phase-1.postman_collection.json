  "item": [
    {
      "name": "GET Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Health response is valid', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql('ok');",
              "    pm.expect(body.app).to.eql('resume-rag-backend');",
              "    pm.expect(body.version).to.eql('1.0.0');",
              "    pm.expect(body.uptime).to.be.a('number');",
              "});",
              "pm.test('Request ID is returned', function () {",
              "    pm.expect(pm.response.headers.get('x-request-id')).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET Database Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/health/db"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP status is 200 or 503', function () {",
              "    pm.expect([200, 503]).to.include(pm.response.code);",
              "});",
              "pm.test('Database response is valid', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.database).to.eql('mongodb');",
              "    pm.expect(body.connected).to.be.a('boolean');",
              "    if (body.connected) {",
              "        pm.expect(body.status).to.eql('ok');",
              "        pm.expect(body.latencyMs).to.be.a('number');",
              "    } else {",
              "        pm.expect(body.status).to.eql('error');",
              "        pm.expect(body.errorCode).to.eql('DB_CONNECTION_FAILED');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
